# Postgres local (Docker Compose) — mesmas credenciais do docker-compose.yml.
# Em producao (Vercel), troque pela connection string do Supabase.
# - DATABASE_URL: usada pelo app em runtime. Em producao, o pooler de transacao
#   do Supabase (porta 6543, usuario postgres.<ref>).
# - DIRECT_URL: usada so pelas ferramentas de CLI (prisma migrate deploy no build,
#   db seed). Em producao, o SESSION pooler do Supabase: mesmo host da pooler,
#   porta 5432 (nao 6543), usuario postgres.<ref>. NAO usar a conexao direta
#   (db.<ref>.supabase.co) — ela e so IPv6 e o build da Vercel nao alcanca.
#   Em dev pode ficar vazia — o Prisma cai de volta na DATABASE_URL.
DATABASE_URL="postgresql://sheep:sheep@localhost:5433/sheepcontabil"
DIRECT_URL=""

# Gere cada um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
CRON_SECRET=""

# Chave da API da Anthropic (necessaria a partir do modulo SC-01).
ANTHROPIC_API_KEY=""
